# ── Backend (server workspace) ───────────────────────────────────────────────
# Copy this file to `.env` at the repository ROOT — it works for both
# workspaces (the server loads it explicitly and Vite loads it for the client
# when you run the dev scripts from the root).
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB Atlas connection string (optional). When present, hybrid retrieval
# uses MongoDB Atlas Vector Search; otherwise the in-memory TF-IDF +
# cosine fallback in server/vectorStore.ts is used.
MONGODB_URI=

# Express server port (the client dev proxy targets this)
PORT=8787

# Comma-separated allowed CORS origins (defaults to reflect request origin)
CORS_ORIGIN=

# Override model names if required
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# MongoDB Atlas Vector Search collection + index names (used by `npm run seed`)
MONGODB_COLLECTION=puarai_regulations
MONGODB_VECTOR_INDEX=puarai_vector_index

# ── Frontend (client workspace / Vite dev proxy) ─────────────────────────────
# Backend origin that the Vite dev server proxies /api to
VITE_API_PROXY=http://localhost:8787
# Optional: point the BUILT client at a remote backend origin (defaults to /api)
# VITE_API_BASE=http://localhost:8787/api