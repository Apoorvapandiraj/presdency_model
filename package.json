{
  "name": "puarai",
  "version": "1.0.0",
  "private": true,
  "description": "Presidency University Academic Regulations AI (PUARAI) — client-server monorepo: React 19/Vite chat UI + Express RAG API with citation-grounded answers.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w client",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "start": "npm run start -w server",
    "preview": "npm run preview -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "typecheck:client": "npm run typecheck -w client",
    "typecheck:server": "npm run typecheck -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}